# Model router backends (Phase 0+)
ANTHROPIC_API_KEY=sk-ant-your-key-here
GROQ_API_KEY=gsk-your-key-here
# Fallback navigator when Groq fails (429 budget, or a malformed tool call) —
# optional, but without it the navigator drops straight to the weak local
# model on any Groq failure. gpt-4o-mini's tool-calling is far more reliable
# than Llama-3.3's on Groq; only billed when Groq has already failed.
OPENAI_API_KEY=sk-your-key-here
OLLAMA_HOST=http://localhost:11434

# Platform (Phase 1+)
DATABASE_URL=postgresql://user:pass@localhost:5432/dvv
OBJECT_STORE_ENDPOINT=https://your-r2-or-s3-endpoint
OBJECT_STORE_KEY=your-key
OBJECT_STORE_SECRET=your-secret
