# ---------------------------------------------------------------------------
# Model router backends (Phase 0+)
#
# OPEN-WEIGHTS-ONLY is the DEFAULT. Client questionnaires and verbatims are
# covered by NDAs, so the proprietary backends (OpenAI, Anthropic) are dropped
# from every fallback chain even when their keys are present. Set
# LLM_OPEN_WEIGHTS_ONLY=0 to opt out — do that deliberately, not by accident.
# ---------------------------------------------------------------------------
LLM_OPEN_WEIGHTS_ONLY=1

# Groq — the primary open-weight backend. Its entire catalog is open-weight.
GROQ_API_KEY=gsk-your-key-here
# gpt-oss-120b (Apache 2.0) is both cheaper and stronger on schema-constrained
# extraction than the llama-3.3-70b it replaced. Benchmark any change against a
# real client document before switching — tests/ has no accuracy oracle.
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras — very fast, own key (not via HF, which bills its own credits).
#   VERIFIED 2026-08-29: a fresh Cerebras account returned HTTP 402
#   "payment_required" (param: quota) for BOTH served models, so there is no
#   usable free quota out of the box — despite what third-party "free LLM API"
#   roundups claim. Treat this backend as paid unless your billing tab shows
#   otherwise. Ask the API what it serves rather than guessing a model id:
#     curl https://api.cerebras.ai/v1/models -H "Authorization: Bearer $KEY"
CEREBRAS_API_KEY=csk-your-key-here
CEREBRAS_MODEL=gpt-oss-120b

# Hugging Face Inference Providers — OpenAI-compatible router that fans out to
# whichever provider serves a model, so ONE key reaches the whole open-weight
# catalog. Swapping models is a config change, not a code change.
HF_TOKEN=hf_your-token-here
HF_MODEL=Qwen/Qwen3-32B
# Pin a provider for structured output — HF's own docs recommend it, because
# schema support varies across the providers behind the auto-router and a
# mismatch surfaces as "no structured output" rather than a clean error.
HF_PROVIDER=cerebras

# Local Ollama — first in the chain as a free fast-fail, NOT as a quality tier.
# An 8GB machine cannot run a model strong enough for spec-table extraction;
# treat local results as plumbing checks, not accuracy signals.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EXTRACT_MODEL=llama3.2:3b

# Proprietary tail — ignored unless LLM_OPEN_WEIGHTS_ONLY=0. Leave unset in any
# deployment handling real client data.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Platform (Phase 1+)
DATABASE_URL=postgresql://user:pass@localhost:5432/dvv
OBJECT_STORE_ENDPOINT=https://your-r2-or-s3-endpoint
OBJECT_STORE_KEY=your-key
OBJECT_STORE_SECRET=your-secret
