#!/usr/bin/env bash
# Operate one client's DVV Research Cloud. Run from anywhere; acts on this directory.
#
#   ./dvv init <client-slug> <domain> <admin-email>   first-time setup, writes .env
#   ./dvv up                                          start / apply .env changes
#   ./dvv status                                      containers, health, licence
#   ./dvv logs [service]                              follow logs
#   ./dvv backup                                      back up now
#   ./dvv restore <db-*.dump> [files-*.tgz]           restore (takes a backup first)
#   ./dvv upgrade                                     backup, update, roll back if unhealthy
#   ./dvv audit                                       which studies a parser fix did not reach
#   ./dvv offsite                                     copy backups to S3 now (offsite profile)
#   ./dvv fetch                                       download this client's backups from S3
#   ./dvv check-ai                                    which AI model answers, and can it use tools
#   ./dvv load-seed | load-cleanup                    set up / remove the go-live load test
#   ./dvv db-reader                                   read-only database login (new password each run)
#   ./dvv embedder                                    switch on the search embedder (nomic-embed-text)
#   ./dvv eval                                        run the Copilot eval now (score -> Admin)
#   ./dvv eval-nightly on|off                         run it every night at 02:30 (~$0.10 a run)
set -euo pipefail
cd "$(dirname "$0")"

# Run as the user that owns the checkout. Under sudo, git reaches GitHub as
# root — which has neither the deploy key nor GitHub's host key — so `upgrade`
# takes a backup and THEN dies on "Host key verification failed", which reads
# like a broken deploy key rather than the wrong user. Fail before the backup,
# and say what to type instead.
owner=$(stat -c '%U' . 2>/dev/null || stat -f '%Su' . 2>/dev/null || echo "")
if [ "$(id -u)" = "0" ] && [ -n "$owner" ] && [ "$owner" != "root" ]; then
  echo "Run this as $owner, not root: sudo -u $owner ./dvv ${*:-status}"
  exit 1
fi

dc() { docker compose "$@"; }

build_app() {  # always stamps the image with the commit it was built from
  # Written into the build context so `COPY . .` carries it INSIDE the image.
  # The old route was a build ARG turned into an ENV, which compose
  # substitution and `env_file:` can each override — and it did go stale,
  # reporting the previous day's commit while serving new code.
  git rev-parse --short HEAD > ../.build-commit 2>/dev/null || echo unknown > ../.build-commit
  GIT_COMMIT=$(cat ../.build-commit) \
    dc up -d --build "$@"
}

reported_commit() {  # what the RUNNING app says it is, from outside the build
  health | sed -n 's/.*"commit":"\([^"]*\)".*/\1/p'
}

health() {  # 0 when the app answers /api/health from inside its container
  dc exec -T app python -c "import urllib.request,sys; sys.stdout.write(urllib.request.urlopen('http://localhost:8000/api/health', timeout=5).read().decode())" 2>/dev/null
}

wait_healthy() {  # up to ~3 minutes: first boot builds indexes, pulls nothing
  for _ in $(seq 36); do health >/dev/null && return 0; sleep 5; done
  return 1
}

pull_model() {  # only when this client runs Ollama (embed or local-ai profile)
  if grep -qE '^COMPOSE_PROFILES=.*(embed|local-ai)' .env; then
    # The embedding model first: it is a few hundred MB, and it is what lets
    # the copilot find "how much would you pay" from "price sensitivity".
    # Without it search still works, by wording alone.
    embed=$(grep '^DVV_EMBED_MODEL=' .env | cut -d= -f2); embed=${embed:-nomic-embed-text}
    echo "Pulling embedding model $embed (first time only)..."
    dc exec -T ollama ollama pull "$embed"
  fi
  if grep -q '^COMPOSE_PROFILES=.*local-ai' .env; then
    model=$(grep '^OLLAMA_EXTRACT_MODEL=' .env | cut -d= -f2); model=${model:-llama3.2:3b}
    echo "Pulling local model $model (first time only; a few GB)..."
    dc exec -T ollama ollama pull "$model"
  fi
}

case "${1:-}" in
  init)
    [ $# -eq 4 ] || { echo "usage: ./dvv init <client-slug> <domain> <admin-email>"; exit 1; }
    [ -e .env ] && { echo ".env already exists — refusing to overwrite a live client's secrets."; exit 1; }
    rand() { openssl rand -base64 36 | tr -d '/+=' | cut -c1-"$1"; }
    admin_pw=$(rand 20)
    sed -e "s/^CLIENT_SLUG=.*/CLIENT_SLUG=$2/" \
        -e "s/^DOMAIN=.*/DOMAIN=$3/" \
        -e "s/^ADMIN_EMAIL=.*/ADMIN_EMAIL=$4/" \
        -e "s/^ADMIN_PASSWORD=.*/ADMIN_PASSWORD=$admin_pw/" \
        -e "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(rand 32)/" \
        -e "s/^JWT_SECRET=.*/JWT_SECRET=$(rand 48)/" \
        .env.example > .env
    chmod 600 .env
    echo "Wrote .env for $2. Owner login: $4 / $admin_pw  (shown once — store it)."
    echo "Next: paste DVV_LICENCE into .env, choose the AI mode, then ./dvv up"
    ;;
  up)
    build_app
    if ! wait_healthy; then echo "App did not become healthy:"; dc logs --tail 60 app; exit 1; fi
    pull_model
    echo "Up. $(health)"
    ;;
  status)
    dc ps
    echo; health && echo || echo "app: NOT answering /api/health"
    echo; ls -1t backups/db-*.dump 2>/dev/null | head -1 | sed 's/^/latest backup: /' || echo "latest backup: none yet"
    ;;
  logs)
    dc logs -f --tail 100 "${@:2}"
    ;;
  backup)
    dc exec -T backup bash /backup.sh once
    ;;
  restore)
    [ -f "${2:-}" ] || { echo "usage: ./dvv restore backups/db-<stamp>.dump [backups/files-<stamp>.tgz]"; exit 1; }
    echo "Safety backup of the current state first..."; dc exec -T backup bash /backup.sh once
    dc stop app
    trap 'dc start app' EXIT  # whatever happens below, never leave the app stopped
    # pg_restore exits non-zero on harmless warnings too; report, don't abort.
    dc exec -T db pg_restore -U dvv -d dvv --clean --if-exists --no-owner < "$2" \
      || echo "pg_restore reported problems — read the output above before trusting this restore."
    if [ -n "${3:-}" ]; then
      dc run --rm --no-deps -T -v "$(cd "$(dirname "$3")" && pwd):/restore:ro" --entrypoint sh app \
        -c "find /app/studies -mindepth 1 -delete && tar xzf /restore/$(basename "$3") -C /app/studies"
    fi
    trap - EXIT; dc start app
    wait_healthy && echo "Restored and healthy." || { echo "Restored, but the app is not healthy:"; dc logs --tail 60 app; exit 1; }
    ;;
  audit)
    # Which studies a parser fix did not reach. Runs against this client's live
    # database; exits 1 when something is affected, so it can gate a script.
    dc exec -T app python3 /app/scripts/audit_definitions.py
    ;;
  upgrade)
    # NOTE: bash already read this file, so the code running here is the
    # PRE-pull version. A change to the upgrade path itself (including what
    # build_app stamps into the image) takes effect on the NEXT upgrade, not
    # this one. Re-execing after the pull would fix that and is not worth the
    # loop-guard it needs.
    echo "Backing up before upgrading..."; dc exec -T backup bash /backup.sh once
    previous=$(git rev-parse HEAD)
    git pull --ff-only
    [ "$(git rev-parse HEAD)" = "$previous" ] && { echo "Already on the latest version."; exit 0; }
    build_app app
    if wait_healthy; then
      echo "Upgraded $(git rev-parse --short "$previous") -> $(git rev-parse --short HEAD). $(health)"
      # Verify the CONTAINER is the build we just made. A rebuilt image that
      # was not recreated, or a stale stamp, is otherwise silent: the deploy
      # reads as successful and the version you check afterwards is a lie.
      expected=$(git rev-parse --short HEAD)
      running=$(reported_commit)
      if [ "$running" != "$expected" ]; then
        echo
        echo "WARNING: the app reports commit '$running' but '$expected' was just built."
        echo "The new image may not be the one running. Check: docker compose ps, then"
        echo "  docker compose up -d --force-recreate app"
      fi
      # A parser fix only changes the NEXT extraction. Studies already in this
      # database keep whatever the old parser wrote, and nothing announces it —
      # a questionnaire missing its screen-outs looks exactly like one that
      # screens nobody out, and it will field and pay for every respondent who
      # should have been turned away. So the upgrade says which studies are
      # affected, instead of waiting to be asked.
      echo
      # Exit 1 means it FOUND something, which is the normal case after a parser
      # fix and is not an upgrade failure. Anything higher means the audit could
      # not run, which is worth saying out loud rather than passing over.
      audit_status=0
      dc exec -T app python3 /app/scripts/audit_definitions.py || audit_status=$?
      [ "$audit_status" -gt 1 ] && echo "(Could not run the audit — try ./dvv audit.)"
    else
      # Schema changes are additive only (api/db.py:_ensure_new_columns), so
      # the previous code runs fine against the upgraded database.
      echo "New version is NOT healthy — rolling back to $(git rev-parse --short "$previous")."
      dc logs --tail 60 app
      git reset -q --hard "$previous" && build_app app && wait_healthy \
        && echo "Rolled back; still on $(git rev-parse --short "$previous")." \
        || echo "ROLLBACK ALSO UNHEALTHY — restore from backups/ with ./dvv restore"
      exit 1
    fi
    ;;
  load-seed)
    dc exec -T -e PYTHONPATH=/app app python scripts/load_test.py --seed-only
    ;;
  load-cleanup)
    dc exec -T -e PYTHONPATH=/app app python scripts/load_test.py --cleanup
    ;;
  check-ai)
    # PYTHONPATH: the script sits in scripts/, so without it the app package
    # under /app is not importable and the check dies before it starts.
    dc exec -T -e PYTHONPATH=/app app python scripts/check_ai.py
    ;;
  offsite)
    dc exec -T offsite bash /offsite.sh once
    ;;
  eval)
    # Uses Bedrock (the real model) on synthetic projects in a throwaway
    # database; only the score lands in this one. Logged for the nightly run.
    mkdir -p logs
    dc exec -T -e PYTHONPATH=/app app python scripts/eval_copilot.py \
      --out "/tmp/copilot-eval-latest.json" 2>&1 | tee -a logs/copilot-eval.log
    ;;
  eval-nightly)
    here=$(pwd)
    line="30 2 * * * cd $here && ./dvv eval >/dev/null 2>&1  # dvv-copilot-eval"
    current=$(crontab -l 2>/dev/null | grep -v 'dvv-copilot-eval' || true)
    case "${2:-}" in
      on)  printf '%s\n%s\n' "$current" "$line" | sed '/^$/d' | crontab -
           echo "On: every night at 02:30 server time. Scores appear in Admin -> Copilot answers." ;;
      off) printf '%s\n' "$current" | sed '/^$/d' | crontab -
           echo "Off." ;;
      *)   echo "usage: ./dvv eval-nightly on|off"; exit 1 ;;
    esac
    ;;
  embedder)
    # Turn on real search-by-meaning: Ollama with ONLY the embedding model,
    # memory-capped, then pull it and check it answers. Re-indexing is
    # automatic (each stored vector records what made it).
    if grep -qE '^COMPOSE_PROFILES=.*(embed|local-ai)' .env; then
      echo "Already on: $(grep '^COMPOSE_PROFILES=' .env)"
    elif grep -q '^COMPOSE_PROFILES=' .env; then
      sed -i.bak 's/^COMPOSE_PROFILES=\(.*\)/COMPOSE_PROFILES=\1,embed/' .env && rm -f .env.bak
    else
      echo 'COMPOSE_PROFILES=embed' >> .env
    fi
    grep -q '^DVV_EMBED_MODEL=' .env || echo 'DVV_EMBED_MODEL=nomic-embed-text' >> .env
    dc up -d ollama
    pull_model
    dc up -d app  # re-read .env
    wait_healthy || { echo "App did not come back healthy:"; dc logs --tail 60 app; exit 1; }
    dc exec -T -e PYTHONPATH=/app app python scripts/check_ai.py --embeddings-only
    echo; free -h 2>/dev/null | head -2
    ;;
  db-reader)
    # A login that can READ the data and nothing else, for DBeaver, Excel,
    # Power BI or Python on a laptop, through an SSH tunnel. Running it again
    # gives it a new password (the old one stops working). Not readable by it:
    # users (password hashes) and share_links (tokens that open a study).
    pw=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
    dc exec -T db psql -q -v ON_ERROR_STOP=1 -U dvv -d dvv <<SQL
DO \$\$ BEGIN
  IF EXISTS (SELECT FROM pg_roles WHERE rolname = 'dvv_reader') THEN
    ALTER ROLE dvv_reader WITH LOGIN PASSWORD '${pw}';
  ELSE
    CREATE ROLE dvv_reader WITH LOGIN PASSWORD '${pw}';
  END IF;
END \$\$;
ALTER ROLE dvv_reader SET default_transaction_read_only = on;
GRANT CONNECT ON DATABASE dvv TO dvv_reader;
GRANT USAGE ON SCHEMA public TO dvv_reader;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO dvv_reader;
ALTER DEFAULT PRIVILEGES FOR ROLE dvv IN SCHEMA public GRANT SELECT ON TABLES TO dvv_reader;
REVOKE ALL ON TABLE users, share_links FROM dvv_reader;
SQL
    ip=$(curl -s --max-time 5 https://checkip.amazonaws.com || echo "<server-ip>")
    cat <<EOT
Read-only login ready. Shown once — save it in your password manager.

  user      dvv_reader
  password  ${pw}
  database  dvv

On your laptop, open the tunnel (leave it running):
  ssh -i <your-lightsail-key.pem> -N -L 5433:127.0.0.1:${DB_LOCAL_PORT:-5432} ubuntu@${ip}
then connect DBeaver / TablePlus / Power BI to host localhost, port 5433.
(Or let DBeaver open the tunnel itself: SSH tab -> host ${ip}, user ubuntu, your key;
 Main tab -> host localhost, port ${DB_LOCAL_PORT:-5432}.)
EOT
    ;;
  fetch)
    # The way back after losing the server: pull every copy S3 holds into
    # backups/, then ./dvv restore the newest pair.
    bucket=$(grep '^BACKUP_S3_BUCKET=' .env | cut -d= -f2)
    slug=$(grep '^CLIENT_SLUG=' .env | cut -d= -f2)
    dc run --rm --no-deps -T --entrypoint aws offsite \
      s3 sync "s3://${bucket}/${slug}/" /backups --only-show-errors
    ls -1t backups/db-*.dump | head -3
    ;;
  *)
    sed -n '2,19p' "$0"; exit 1
    ;;
esac
