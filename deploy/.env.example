# One client's settings. Created by `./dvv init`; never committed (gitignored).
# Comments stay on their own lines: an inline "# note" can end up inside a value.

# --- Identity ---------------------------------------------------------------
# Lowercase, unique per client.
CLIENT_SLUG=acme
# Its DNS A record must point at this server.
DOMAIN=research.acme.com
ADMIN_EMAIL=owner@acme.com
ADMIN_NAME=Acme Admin
# Generated by ./dvv init.
ADMIN_PASSWORD=
# From: python scripts/issue_licence.py issue --client "<name>" --expires YYYY-MM-DD
DVV_LICENCE=

# --- Secrets (generated by ./dvv init) --------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=

# --- AI, chosen per client --------------------------------------------------
# Open-source models only: no proprietary AI vendor exists anywhere in the code.
# Local model on this server, no outside AI at all. Needs ~8 GB RAM; a GPU
# makes it fast. To enable, uncomment both lines:
# COMPOSE_PROFILES=local-ai
# OLLAMA_EXTRACT_MODEL=llama3.2:3b
# The copilot's search index: ./dvv embedder turns it on (COMPOSE_PROFILES=embed),
# without the big extraction model — a few hundred MB, fine on a 4 GB CPU server,
# memory-capped at OLLAMA_MEMORY (default 1g). With it, the copilot finds "how much
# would you be willing to pay" from "price sensitivity"; without it, search matches
# wording only (measured: held-out MRR 0.79 vs 0.61, scripts/eval_retrieval.py).
# Client questionnaires and verbatims are embedded on this server, never sent anywhere.
# COMPOSE_PROFILES=embed
# DVV_EMBED_MODEL=nomic-embed-text
# External open-weights API. Questionnaire text leaves the server for these calls:
# GROQ_API_KEY=
# CEREBRAS_API_KEY=

# Amazon Bedrock, in this client's AWS region (the default on AWS). The key belongs
# to this client's app identity: it can invoke the one model and nothing else.
# BEDROCK_API_KEY=
# BEDROCK_REGION=ap-south-1
# The Copilot's fallback when the main model fails: Qwen3 235B on Bedrock, in the
# same region by default (Mumbai offers it; it does not offer Llama 3.3 70B).
# `./dvv check-ai` tests it. Another region: set BEDROCK_FALLBACK_REGION (client
# text then leaves this region — the client's call). Off: BEDROCK_FALLBACK_MODEL=none.
# BEDROCK_FALLBACK_MODEL=qwen.qwen3-235b-a22b-2507-v1:0
# Screenshots pasted into the copilot are read by a vision model, same region.
# ./dvv check-ai says whether it answers; empty turns screenshots off.
# BEDROCK_VISION_MODEL=qwen.qwen3-vl-235b-a22b
# BEDROCK_FALLBACK_REGION=

# --- Backups ----------------------------------------------------------------
# Hour of day, server time.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# Off-server copies in S3 (made one hour after the nightly backup). To enable,
# add "offsite" to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=offsite, or
# local-ai,offsite) and fill these from deploy/aws/provision.sh's output:
# BACKUP_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
